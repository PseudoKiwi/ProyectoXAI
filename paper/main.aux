\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Cosine similarities between vectorized attention maps of student $S_1$, student $S_2$, and teacher $P$. $S_1$ was trained by minimizing the $KL$ divergence over the full vocabulary with respect to the teacher, whereas $S_2$ additionally incorporates a $KL$ term restricted to the target tokens in order to preserve the argmax. For each student layer $i$, the teacher representations are obtained as the average attention map $P_{avg}$ and the Attention Rollout $P_r$ computed from layers $2i$ and $2i+1$. Comparisons between $S_1$ and $P$, $S_2$ and $P$, and $S_1$ and $S_2$ are reported.}}{11}{table.caption.14}\protected@file@percent }
\newlabel{cosine_similarity}{{IV}{11}{Cosine similarities between vectorized attention maps of student $S_1$, student $S_2$, and teacher $P$. $S_1$ was trained by minimizing the $KL$ divergence over the full vocabulary with respect to the teacher, whereas $S_2$ additionally incorporates a $KL$ term restricted to the target tokens in order to preserve the argmax. For each student layer $i$, the teacher representations are obtained as the average attention map $P_{avg}$ and the Attention Rollout $P_r$ computed from layers $2i$ and $2i+1$. Comparisons between $S_1$ and $P$, $S_2$ and $P$, and $S_1$ and $S_2$ are reported}{table.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Layer-wise Frobenius distance between attention maps. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit  {rollout}. Same notation as in Table~\ref {cosine_similarity}.}}{11}{table.caption.15}\protected@file@percent }
\newlabel{frobenius_distance}{{V}{11}{Layer-wise Frobenius distance between attention maps. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit {rollout}. Same notation as in Table~\ref {cosine_similarity}}{table.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces Row-averaged $JS$ divergence between attention maps. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit  {rollout}. Same notation as in Table~\ref {cosine_similarity}.}}{11}{table.caption.16}\protected@file@percent }
\newlabel{JS}{{VI}{11}{Row-averaged $JS$ divergence between attention maps. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit {rollout}. Same notation as in Table~\ref {cosine_similarity}}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces $PR$ computed for each attention map. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit  {rollout}.}}{11}{table.caption.17}\protected@file@percent }
\newlabel{participation_ratio}{{VII}{11}{$PR$ computed for each attention map. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit {rollout}}{table.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces $ER$ computed for each attention map. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit  {rollout}.}}{12}{table.caption.18}\protected@file@percent }
\newlabel{entropy_based}{{VIII}{12}{$ER$ computed for each attention map. $S_1$, $S_2$: students; $P_{avg}$, $P_r$: teacher average attention map and \textit {rollout}}{table.caption.18}{}}
